# BeastMailer Auto-Reply — backend environment template
# Copy this file to `.env` and fill in real values:  cp .env.example .env

# Django secret key. Generate one with:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(56)))"
DJANGO_SECRET_KEY=change-me

# 1 = debug on (dev), 0 = production.
DJANGO_DEBUG=1

# Comma-separated allowed hosts (use your domain in production, e.g. api.example.com).
DJANGO_ALLOWED_HOSTS=*

# Fernet key that encrypts mailbox & proxy passwords at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable — changing it makes stored passwords unreadable.
MAIL_ENCRYPTION_KEY=

# Comma-separated origins allowed to call the API (ignored while DJANGO_DEBUG=1).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -------------------------------------------------------------
# Leave empty to use the bundled SQLite file (local dev).
# Set it to switch to Postgres running on this same server (production).
# Host stays localhost — the database is never exposed to the network.
#   DATABASE_URL=postgresql://beastmailer:password@localhost:5432/beastmailer
DATABASE_URL=
